diff --git a/src/import_trace.h b/src/import_trace.h
index 40be4ed..990beed 100644
--- a/src/import_trace.h
+++ b/src/import_trace.h
@@ -13,6 +13,7 @@
 #include <windows.h>
 
 #include <rex/cvar.h>
+#include <rex/platform.h>
 #include <rex/logging.h>
 #include <rex/ppc/func.h>
 
@@ -25,8 +26,15 @@ using ImportFn = void (*)(PPCContext&, uint8_t*);
 
 inline ImportFn Resolve(const char* name) {
   static HMODULE runtime = [] {
+#if REX_PLATFORM_WINRT
+    // No GetModuleHandle for UWP apps; LoadPackagedLibrary returns the
+    // already-loaded runtime DLL from the package.
+    HMODULE m = LoadPackagedLibrary(L"rexruntimerd.dll", 0);
+    return m ? m : LoadPackagedLibrary(L"rexruntime.dll", 0);
+#else
     HMODULE m = GetModuleHandleA("rexruntimerd.dll");
     return m ? m : GetModuleHandleA("rexruntime.dll");
+#endif
   }();
   return reinterpret_cast<ImportFn>(GetProcAddress(runtime, name));
 }
