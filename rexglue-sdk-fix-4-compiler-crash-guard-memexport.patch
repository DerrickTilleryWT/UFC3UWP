+  }
+  static uint32_t memexport_skip_logs_left = 48;
+  auto log_memexport_skip = [&](const char* reason) {
+    if (memexport_used && memexport_skip_logs_left) {
+      --memexport_skip_logs_left;
+      REXGPU_WARN("Memexport draw VS {:016X} skipped: {}", vertex_shader->ucode_data_hash(),
+                  reason);
+    }
+  };
+#else
+  auto log_memexport_skip = [](const char*) {};
+#endif
 
   draw_util::LogIntegerTextureFetches(regs, *vertex_shader);
