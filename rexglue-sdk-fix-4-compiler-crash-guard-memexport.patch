@@ -2453,16 +2476,19 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
   }
 
   if (!BeginSubmission(true)) {
+    log_memexport_skip("BeginSubmission failed");
