     // Nothing to draw.
+    log_memexport_skip("no host vertices");
     return true;
   }
 
@@ -2491,6 +2517,7 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
                    : 0;
   if (!render_target_cache_->Update(is_rasterization_done, normalized_depth_control,
                                     normalized_color_mask, *vertex_shader)) {
+    log_memexport_skip("render target update failed");
     return false;
   }
 
@@ -2521,10 +2548,12 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
           vertex_shader_translation, pixel_shader_translation, primitive_processing_result,
           normalized_depth_control, normalized_color_mask, bound_depth_and_color_render_target_bits,
           bound_depth_and_color_render_target_formats, &pipeline_handle, &root_signature)) {
+    log_memexport_skip("pipeline configuration failed");
     return false;
   }
   if (REXCVAR_GET(async_shader_compilation) &&
       pipeline_cache_->GetD3D12PipelineByHandle(pipeline_handle) == nullptr) {
+    log_memexport_skip("pipeline not ready or failed");
     return true;
   }
 
@@ -2596,6 +2625,7 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
 
   // Update constant buffers, descriptors and root parameters.
   if (!UpdateBindings(vertex_shader, pixel_shader, root_signature, memexport_used)) {
+    log_memexport_skip("binding update failed");
     return false;
   }
   // Must not call anything that can change the descriptor heap from now on!
@@ -2840,6 +2870,23 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
       shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize);
       DropReadbackAhead(0, SharedMemory::kBufferSize);
     }
+#if REX_PLATFORM_WINRT
+    {
+      static uint32_t memexport_range_logs_left = 48;
+      if (memexport_range_logs_left) {
+        --memexport_range_logs_left;
+        uint64_t memexport_log_total = 0;
+        for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+          memexport_log_total += memexport_range.size_bytes;
+        }
+        REXGPU_INFO(
+            "Memexport draw VS {:016X} done: {} ranges, {} bytes, first at {:08X}, readback {}",
+            vertex_shader->ucode_data_hash(), memexport_ranges_.size(), memexport_log_total,
+            memexport_ranges_.empty() ? 0u : (memexport_ranges_.front().base_address_dwords << 2),
+            IsReadbackMemexportEnabled(REXCVAR_GET(d3d12_readback_memexport)) ? 1 : 0);
+      }
+    }
+#endif
     if (IsReadbackMemexportEnabled(REXCVAR_GET(d3d12_readback_memexport)) &&
         !memexport_ranges_.empty()) {
       uint32_t memexport_total_size = 0;
@@ -2868,6 +2915,7 @@ bool D3D12CommandProcessor::IssueDraw_MemexportReadbackFullPath(uint32_t total_s
 
   ID3D12Resource* readback_buffer = RequestReadbackBuffer(total_size);
   if (!readback_buffer) {
+    REXGPU_ERROR("Memexport readback: no {}-byte readback buffer", total_size);
     return true;
   }
 
@@ -2886,6 +2934,7 @@ bool D3D12CommandProcessor::IssueDraw_MemexportReadbackFullPath(uint32_t total_s
   }
 
   if (!AwaitAllQueueOperationsCompletion()) {
+    REXGPU_ERROR("Memexport readback: waiting for the GPU failed");
     return true;
   }
 
@@ -2894,6 +2943,7 @@ bool D3D12CommandProcessor::IssueDraw_MemexportReadbackFullPath(uint32_t total_s
   readback_range.End = total_size;
   void* readback_mapping = nullptr;
   if (FAILED(readback_buffer->Map(0, &readback_range, &readback_mapping))) {
+    REXGPU_ERROR("Memexport readback: mapping the {}-byte readback buffer failed", total_size);
     return true;
   }
 
diff --git a/src/graphics/d3d12/pipeline_cache.cpp b/src/graphics/d3d12/pipeline_cache.cpp
index a8bb7c2..0f23d8d 100644
--- a/src/graphics/d3d12/pipeline_cache.cpp
+++ b/src/graphics/d3d12/pipeline_cache.cpp
@@ -282,6 +282,25 @@ void PipelineCache::InitializeShaderStorage(const std::filesystem::path& cache_r
     if (FILE* marker = rex::filesystem::OpenFile(pipeline_storage_loading_marker, "wb")) {
       fclose(marker);
     }
+    blocked_pipelines_path_ =
+        shader_storage_shareable_root /
+        fmt::format("{:08X}.{}.d3d12.blocked.txt", title_id, edram_rov_used ? "rov" : "rtv");
+    std::lock_guard<std::mutex> lock(blocked_pipelines_mutex_);
+    blocked_pipelines_.clear();
+    if (FILE* blocked_file = rex::filesystem::OpenFile(blocked_pipelines_path_, "rb")) {
+      char line[64];
+      while (std::fgets(line, sizeof(line), blocked_file)) {
+        uint64_t hash = std::strtoull(line, nullptr, 16);
+        if (hash) {
+          blocked_pipelines_.push_back(hash);
+        }
+      }
+      fclose(blocked_file);
+    }
+    if (!blocked_pipelines_.empty()) {
+      REXGPU_WARN("{} graphics pipeline(s) that crashed the Xbox shader compiler will be skipped",
+                  blocked_pipelines_.size());
+    }
   }
 #endif
   pipeline_storage_file_ = rex::filesystem::OpenFile(pipeline_storage_file_path, "a+b");
@@ -954,6 +973,15 @@ bool PipelineCache::ConfigurePipeline(
 
   bool use_async = REXCVAR_GET(async_shader_compilation) && !creation_threads_.empty() &&
                    pixel_shader != nullptr;
+#if REX_PLATFORM_WINRT
+  // A memexport draw that's skipped while its pipeline compiles never writes
+  // its data (UFC 3 builds textures this way once, when a fighter loads), and
+  // the Xbox compiles slowly: create memexport pipelines right away.
+  if (use_async && (vertex_shader->shader().memexport_eM_written() ||
+                    pixel_shader->shader().memexport_eM_written())) {
+    use_async = false;
+  }
+#endif
 
   // Ensure shaders are translated - needed now for GetCurrentStateDescription.
   // Edge flags are not supported yet (because polygon primitives are not).
@@ -2718,19 +2746,77 @@ const std::vector<uint32_t>& PipelineCache::GetGeometryShader(GeometryShaderKey
   return geometry_shaders_.emplace(key, std::move(shader)).first->second;
 }
 
+#if REX_PLATFORM_WINRT
+namespace {
+// The Xbox driver compiles the shaders inside CreateGraphicsPipelineState, and
+// its compiler can fault on some of them (an access violation in newbe_xs.dll),
+// which would end the app. Structured exception handling turns that into a
+// failed pipeline: the draws using it are skipped instead. No C++ objects with
+// destructors may live in this function.
+__declspec(noinline) HRESULT CreateGraphicsPipelineStateGuarded(
+    ID3D12Device* device, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* desc,
+    ID3D12PipelineState** state_out, unsigned long* exception_code_out) {
+  *state_out = nullptr;
+  *exception_code_out = 0;
+  __try {
+    return device->CreateGraphicsPipelineState(desc, IID_PPV_ARGS(state_out));
+  } __except (*exception_code_out = GetExceptionCode(), EXCEPTION_EXECUTE_HANDLER) {
+    *state_out = nullptr;
+    return E_FAIL;
+  }
+}
+}  // namespace
+
+bool PipelineCache::IsPipelineBlocked(uint64_t description_hash) {
+  std::lock_guard<std::mutex> lock(blocked_pipelines_mutex_);
+  return std::find(blocked_pipelines_.begin(), blocked_pipelines_.end(), description_hash) !=
+         blocked_pipelines_.end();
+}
+
+void PipelineCache::BlockPipeline(uint64_t description_hash) {
+  std::lock_guard<std::mutex> lock(blocked_pipelines_mutex_);
+  if (std::find(blocked_pipelines_.begin(), blocked_pipelines_.end(), description_hash) !=
+      blocked_pipelines_.end()) {
+    return;
+  }
+  blocked_pipelines_.push_back(description_hash);
+  if (blocked_pipelines_path_.empty()) {
+    return;
+  }
+  if (FILE* blocked_file = rex::filesystem::OpenFile(blocked_pipelines_path_, "ab")) {
+    std::string line = fmt::format("{:016X}\n", description_hash);
+    fwrite(line.data(), 1, line.size(), blocked_file);
+    fflush(blocked_file);
+    fclose(blocked_file);
+  }
+}
+#endif
+
 ID3D12PipelineState* PipelineCache::CreateD3D12Pipeline(
     const PipelineRuntimeDescription& runtime_description) {
   const PipelineDescription& description = runtime_description.description;
 
 #if REX_PLATFORM_WINRT
+  const uint64_t description_hash = XXH3_64bits(&description, sizeof(description));
+  if (IsPipelineBlocked(description_hash)) {
+    static uint32_t blocked_logs_left = 32;
+    if (blocked_logs_left) {
+      --blocked_logs_left;
+      REXGPU_WARN("Skipping graphics pipeline {:016X} (VS {:016X}) - it crashed the Xbox shader "
+                  "compiler before",
+                  description_hash, runtime_description.vertex_shader->shader().ucode_data_hash());
+    }
+    return nullptr;
+  }
   // Logged before the driver call on Xbox, where a pipeline the driver can't
   // handle may end the app: the log's last lines then name it.
   {
     const PipelineRenderTarget& rt0 = description.render_targets[0];
     REXGPU_INFO(
-        "Creating graphics pipeline VS {:016X}/{:X} PS {:016X}/{:X}: topology/tess {} GS {} "
-        "cull {} MSAA {} depth fmt {} func {} write {} stencil {} RT0 {} fmt {} blend {}/{}/{}",
-        runtime_description.vertex_shader->shader().ucode_data_hash(),
+        "Creating graphics pipeline {:016X} VS {:016X}/{:X} PS {:016X}/{:X}: topology/tess {} "
+        "GS {} cull {} MSAA {} depth fmt {} func {} write {} stencil {} RT0 {} fmt {} blend "
+        "{}/{}/{}",
+        description_hash, runtime_description.vertex_shader->shader().ucode_data_hash(),
         description.vertex_shader_modification,
         runtime_description.pixel_shader
             ? runtime_description.pixel_shader->shader().ucode_data_hash()
@@ -3098,7 +3184,25 @@ ID3D12PipelineState* PipelineCache::CreateD3D12Pipeline(
   HRESULT create_result;
   {
     perf::Scope perf_scope(perf::Bucket::kPipelineCreation);
+#if REX_PLATFORM_WINRT
+    unsigned long exception_code = 0;
+    create_result =
+        CreateGraphicsPipelineStateGuarded(device, &state_desc, &state, &exception_code);
+    if (exception_code) {
+      REXGPU_ERROR(
+          "The Xbox shader compiler crashed (exception {:08X}) on graphics pipeline {:016X} "
+          "(VS {:016X}, PS {:016X}) - skipping it from now on",
+          uint32_t(exception_code), description_hash,
+          runtime_description.vertex_shader->shader().ucode_data_hash(),
+          runtime_description.pixel_shader
+              ? runtime_description.pixel_shader->shader().ucode_data_hash()
+              : uint64_t(0));
+      BlockPipeline(description_hash);
+      return nullptr;
+    }
+#else
     create_result = device->CreateGraphicsPipelineState(&state_desc, IID_PPV_ARGS(&state));
+#endif
   }
   if (FAILED(create_result)) {
     if (runtime_description.pixel_shader != nullptr) {
