+#if REX_PLATFORM_WINRT
+
+#include <unknwn.h>
+
+namespace rex::ui::winrt_util {
+
+// Gets the size of the CoreWindow in physical pixels. CoreWindow bounds are in
+// device-independent pixels, so they're scaled by the display's raw pixels per
+// view pixel. Must be called on the window's (UI) thread. scale_out receives
+// the physical pixels per DIP.
+bool GetCoreWindowPhysicalSize(IUnknown* core_window, uint32_t& width_out,
+                               uint32_t& height_out, double& scale_out);
+
+}  // namespace rex::ui::winrt_util
+
+#endif  // REX_PLATFORM_WINRT
