+        add_executable(rex::rexglue IMPORTED)
+        set_target_properties(rex::rexglue PROPERTIES
+            IMPORTED_LOCATION "${REXGLUE_CODEGEN_TOOL}")
+    else()
+        message(FATAL_ERROR
+            "UWP build of the ReXGlue SDK: set REXGLUE_CODEGEN_TOOL to rexglue.exe from a "
+            "desktop (win-amd64) build of the same SDK version.")
+    endif()
+endif()
+
 # Only Release rexglue is installed, so every consumer config has to reach it.
 if(TARGET rex::rexglue)
     set_target_properties(rex::rexglue PROPERTIES
