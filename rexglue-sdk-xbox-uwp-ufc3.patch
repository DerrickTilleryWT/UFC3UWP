+/**
+ * @file        ui/windowed_app_context_uwp.h
+ *
+ * @brief       UI loop context for UWP builds (Xbox Developer Mode), running on
+ *              the CoreWindow's thread instead of a Win32 message loop.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include <rex/platform.h>
+#include <rex/ui/windowed_app_context.h>
+
+#if REX_PLATFORM_WINRT
+
+#include <unknwn.h>
+
+namespace rex {
+namespace ui {
+
+class UWPWindow;
+
+class UWPWindowedAppContext final : public WindowedAppContext {
+ public:
+  // core_window is the ABI::Windows::UI::Core::ICoreWindow of the current
+  // view, passed as IUnknown so this header doesn't need WinRT headers. Must
+  // be created on that window's thread, which becomes the UI thread.
+  explicit UWPWindowedAppContext(IUnknown* core_window);
+  ~UWPWindowedAppContext() override;
+
+  bool Initialize();
+
+  // The ICoreWindow, as IUnknown (not AddRef'ed).
+  IUnknown* core_window() const { return core_window_; }
+
+  void NotifyUILoopOfPendingFunctions() override;
+  void PlatformQuitFromUIThread() override;
+
+  int RunMainMessageLoop();
+
+  // The UWP app has a single window - the CoreWindow.
+  void SetWindow(UWPWindow* window) { window_ = window; }
+  UWPWindow* window() const { return window_; }
+
+  // Wakes the UI loop from any thread (for paint requests).
+  void WakeUILoop();
+
+ private:
+  // Stops the system back request (B on Xbox) from closing the app.
+  void HandleBackButton();
+
+  IUnknown* core_window_ = nullptr;
+  IUnknown* navigation_manager_ = nullptr;  // ISystemNavigationManager
+  int64_t back_requested_token_ = 0;  // EventRegistrationToken::value
+  IUnknown* dispatcher_ = nullptr;  // ICoreDispatcher
+  void* wake_event_ = nullptr;      // HANDLE
+  UWPWindow* window_ = nullptr;
+};
+
+}  // namespace ui
+}  // namespace rex
+
+#endif  // REX_PLATFORM_WINRT
