diff --git a/src/audio/xaudio2/xaudio2_audio_driver.cpp b/src/audio/xaudio2/xaudio2_audio_driver.cpp
new file mode 100644
index 0000000..46bf02a
--- /dev/null
+++ b/src/audio/xaudio2/xaudio2_audio_driver.cpp
@@ -0,0 +1,193 @@
+/**
+ * @file        audio/xaudio2/xaudio2_audio_driver.cpp
+ *
+ * @brief       XAudio2 output, for UWP builds (Xbox Developer Mode).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/audio/xaudio2/xaudio2_audio_driver.h>
+
+#if REX_PLATFORM_WINRT
+
+#include <cstring>
+
+#include <roapi.h>
+#include <xaudio2.h>
+
+#include <rex/assert.h>
+#include <rex/audio/conversion.h>
+#include <rex/audio/flags.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+// Defined by the SDL driver on other platforms.
+REXCVAR_DEFINE_BOOL(audio_mute, false,
+    "Mute audio output",
+    "Audio");
+
+namespace rex::audio::xaudio2 {
+
+namespace {
+
+// KSDATAFORMAT_SUBTYPE_IEEE_FLOAT, defined here to avoid ksmedia.h/GUID
+// instantiation differences between SDKs.
+constexpr GUID kSubtypeIeeeFloat = {
+    0x00000003, 0x0000, 0x0010, {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}};
+
+// Xbox 360 6-channel order: front left, front right, front center, LFE, back
+// left, back right - the default 5.1 mapping of XAudio2.
+constexpr DWORD kChannelMask5Point1 = 0x1 | 0x2 | 0x4 | 0x8 | 0x10 | 0x20;
+
+}  // namespace
+
+class XAudio2AudioDriver::VoiceCallback final : public IXAudio2VoiceCallback {
+ public:
+  explicit VoiceCallback(rex::thread::Semaphore* semaphore)
+      : semaphore_(semaphore) {}
+  virtual ~VoiceCallback() = default;
+
+  void STDMETHODCALLTYPE OnStreamEnd() override {}
+  void STDMETHODCALLTYPE OnVoiceProcessingPassEnd() override {}
+  void STDMETHODCALLTYPE OnVoiceProcessingPassStart(UINT32 samples_required) override {
+    (void)samples_required;
+  }
+  void STDMETHODCALLTYPE OnBufferEnd(void* context) override {
+    (void)context;
+    // A queued frame finished playing - let the guest produce another.
+    auto ret = semaphore_->Release(1, nullptr);
+    assert_true(ret);
+    (void)ret;
+  }
+  void STDMETHODCALLTYPE OnBufferStart(void* context) override { (void)context; }
+  void STDMETHODCALLTYPE OnLoopEnd(void* context) override { (void)context; }
+  void STDMETHODCALLTYPE OnVoiceError(void* context, HRESULT error) override {
+    (void)context;
+    REXAPU_ERROR("XAudio2 voice error 0x{:08X}", uint32_t(error));
+  }
+
+ private:
+  rex::thread::Semaphore* semaphore_;
+};
+
+XAudio2AudioDriver::XAudio2AudioDriver(memory::Memory* memory,
+                                       rex::thread::Semaphore* semaphore)
+    : AudioDriver(memory), semaphore_(semaphore) {}
+
+XAudio2AudioDriver::~XAudio2AudioDriver() { assert_null(audio_); }
+
+bool XAudio2AudioDriver::Initialize() {
+  // XAudio2 is COM-based; join the multithreaded apartment if this thread
+  // hasn't entered one (an STA thread keeps its STA, which also works).
+  RoInitialize(RO_INIT_MULTITHREADED);
+
+  HRESULT result = XAudio2Create(&audio_, 0, XAUDIO2_DEFAULT_PROCESSOR);
+  if (FAILED(result)) {
+    REXAPU_ERROR("XAudio2Create failed with 0x{:08X}", uint32_t(result));
+    audio_ = nullptr;
+    return false;
+  }
+
+  result = audio_->CreateMasteringVoice(&mastering_voice_);
+  if (FAILED(result)) {
+    REXAPU_ERROR("IXAudio2::CreateMasteringVoice failed with 0x{:08X}",
+                 uint32_t(result));
+    return false;
+  }
+
+  WAVEFORMATEXTENSIBLE waveformat = {};
+  waveformat.Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+  waveformat.Format.nChannels = WORD(kFrameChannels);
+  waveformat.Format.nSamplesPerSec = kFrameFrequency;
+  waveformat.Format.wBitsPerSample = 32;
+  waveformat.Format.nBlockAlign =
+      WORD(waveformat.Format.nChannels * waveformat.Format.wBitsPerSample / 8);
+  waveformat.Format.nAvgBytesPerSec =
+      waveformat.Format.nSamplesPerSec * waveformat.Format.nBlockAlign;
+  waveformat.Format.cbSize =
+      WORD(sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX));
+  waveformat.Samples.wValidBitsPerSample = waveformat.Format.wBitsPerSample;
+  waveformat.dwChannelMask = kChannelMask5Point1;
+  waveformat.SubFormat = kSubtypeIeeeFloat;
+
+  voice_callback_ = std::make_unique<VoiceCallback>(semaphore_);
+  // XAudio2 downmixes 5.1 to the console's speaker configuration.
+  result = audio_->CreateSourceVoice(
+      &source_voice_, &waveformat.Format, 0, XAUDIO2_MAX_FREQ_RATIO,
+      voice_callback_.get());
+  if (FAILED(result)) {
+    REXAPU_ERROR("IXAudio2::CreateSourceVoice failed with 0x{:08X}",
+                 uint32_t(result));
+    return false;
+  }
+
+  frames_ = std::make_unique<float[]>(size_t(kFrameCount) * kFrameSamples);
+  current_frame_ = 0;
+
+  result = source_voice_->Start(0);
+  if (FAILED(result)) {
+    REXAPU_ERROR("IXAudio2SourceVoice::Start failed with 0x{:08X}",
+                 uint32_t(result));
+    return false;
+  }
+
+  REXAPU_INFO("XAudio2 audio driver initialized");
+  return true;
+}
+
+void XAudio2AudioDriver::SubmitFrame(uint32_t frame_ptr) {
+  if (!source_voice_) {
+    // Keep the guest's audio clock running even without output.
+    semaphore_->Release(1, nullptr);
+    return;
+  }
+
+  const auto input_frame = memory_->TranslateVirtual<float*>(frame_ptr);
+  float* output_frame = &frames_[size_t(current_frame_) * kFrameSamples];
+  current_frame_ = (current_frame_ + 1) % kFrameCount;
+
+  if (REXCVAR_GET(audio_mute) || g_audio_muted.load(std::memory_order_relaxed)) {
+    std::memset(output_frame, 0, sizeof(float) * kFrameSamples);
+  } else {
+    // 5.1 to the mastering voice; XAudio2 folds it down for the device.
+    conversion::sequential_6_BE_to_interleaved_6_LE(output_frame, input_frame, kChannelSamples,
+                                                    GetSurroundMix(), GetOutputGain());
+  }
+
+  XAUDIO2_BUFFER buffer = {};
+  buffer.AudioBytes = UINT32(sizeof(float) * kFrameSamples);
+  buffer.pAudioData = reinterpret_cast<const BYTE*>(output_frame);
+  buffer.PlayBegin = 0;
+  buffer.PlayLength = kChannelSamples;
+  HRESULT result = source_voice_->SubmitSourceBuffer(&buffer);
+  if (FAILED(result)) {
+    REXAPU_ERROR("IXAudio2SourceVoice::SubmitSourceBuffer failed with 0x{:08X}",
+                 uint32_t(result));
+    // The buffer won't complete, so release its slot now.
+    semaphore_->Release(1, nullptr);
+  }
+}
+
+void XAudio2AudioDriver::Shutdown() {
+  if (source_voice_) {
+    source_voice_->Stop(0);
+    source_voice_->DestroyVoice();
+    source_voice_ = nullptr;
+  }
+  if (mastering_voice_) {
+    mastering_voice_->DestroyVoice();
+    mastering_voice_ = nullptr;
+  }
+  if (audio_) {
+    audio_->StopEngine();
+    audio_->Release();
+    audio_ = nullptr;
+  }
+  voice_callback_.reset();
+  frames_.reset();
+}
+
+}  // namespace rex::audio::xaudio2
+
+#endif  // REX_PLATFORM_WINRT
