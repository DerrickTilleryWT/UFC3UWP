+HMODULE GetKernelBaseModule() {
+  // VirtualQuery is implemented in kernelbase.dll, and the import resolves to
+  // it, so the module containing it is kernelbase. GetModuleHandle is not
+  // available to UWP apps, but GetProcAddress is.
+  static const HMODULE module =
+      ModuleFromAddress(reinterpret_cast<const void*>(&VirtualQuery));
+  return module;
+}
+
+HMODULE GetNtdllModule() {
+  static const HMODULE module = []() -> HMODULE {
+    HMODULE kernelbase = GetKernelBaseModule();
+    // The critical section functions are available to UWP apps and are
+    // forwarded by Windows to ntdll's Rtl* versions; imports resolve
+    // forwarders, so these addresses are inside ntdll. Accept a module only
+    // if it really exports the ntdll functions callers look up.
+    const void* candidates[] = {
+        reinterpret_cast<const void*>(&EnterCriticalSection),
+        reinterpret_cast<const void*>(&LeaveCriticalSection),
+        reinterpret_cast<const void*>(&DeleteCriticalSection),
+    };
+    for (const void* address : candidates) {
+      HMODULE candidate = ModuleFromAddress(address);
+      if (candidate && candidate != kernelbase &&
+          GetProcAddress(candidate, "RtlAddVectoredExceptionHandler")) {
+        return candidate;
+      }
+    }
+    // Fallback: kernelbase may export a forwarder to ntdll - GetProcAddress
+    // resolves forwarders, so the returned address is inside ntdll.
+    if (!kernelbase) {
+      return nullptr;
+    }
+    FARPROC forwarded = GetProcAddress(kernelbase, "RtlCaptureContext");
+    HMODULE ntdll = ModuleFromAddress(reinterpret_cast<const void*>(forwarded));
+    return ntdll != kernelbase ? ntdll : nullptr;
+  }();
+  return module;
+}
+
+std::filesystem::path HStringToPath(HSTRING string) {
+  UINT32 length = 0;
+  const wchar_t* raw = WindowsGetStringRawBuffer(string, &length);
+  if (!raw || !length) {
+    return {};
+  }
+  return std::filesystem::path(std::wstring(raw, length));
+}
+
+std::filesystem::path QueryLocalFolder() {
+  using Microsoft::WRL::ComPtr;
+  namespace storage = ABI::Windows::Storage;
+
+  static const wchar_t kClassName[] = L"Windows.Storage.ApplicationData";
+  HSTRING_HEADER class_name_header;
+  HSTRING class_name = nullptr;
+  if (FAILED(WindowsCreateStringReference(
+          kClassName, UINT32(std::size(kClassName) - 1), &class_name_header,
+          &class_name))) {
+    return {};
+  }
+
+  ComPtr<storage::IApplicationDataStatics> statics;
+  HRESULT result =
+      RoGetActivationFactory(class_name, IID_PPV_ARGS(statics.GetAddressOf()));
+  if (result == CO_E_NOTINITIALIZED) {
+    // Called from a thread that hasn't entered the Windows Runtime yet.
+    RoInitialize(RO_INIT_MULTITHREADED);
+    result = RoGetActivationFactory(class_name,
+                                    IID_PPV_ARGS(statics.GetAddressOf()));
+  }
+  if (FAILED(result) || !statics) {
+    return {};
+  }
+
+  ComPtr<storage::IApplicationData> application_data;
+  if (FAILED(statics->get_Current(application_data.GetAddressOf())) ||
+      !application_data) {
+    return {};
+  }
+  ComPtr<storage::IStorageFolder> local_folder;
+  if (FAILED(application_data->get_LocalFolder(local_folder.GetAddressOf())) ||
+      !local_folder) {
+    return {};
+  }
+  ComPtr<storage::IStorageItem> local_folder_item;
+  if (FAILED(local_folder->QueryInterface(
+          IID_PPV_ARGS(local_folder_item.GetAddressOf())))) {
+    return {};
+  }
+  HSTRING path_string = nullptr;
+  if (FAILED(local_folder_item->get_Path(&path_string))) {
+    return {};
+  }
+  std::filesystem::path path = HStringToPath(path_string);
+  WindowsDeleteString(path_string);
+  return path;
+}
+
+std::filesystem::path QueryExecutablePath() {
+  // GetModuleFileNameW isn't declared for the UWP API partition by every
+  // Windows SDK, so it's looked up at runtime.
+  using GetModuleFileNameWFn = DWORD(WINAPI*)(HMODULE, LPWSTR, DWORD);
+  static const auto get_module_file_name =
+      GetSystemProc<GetModuleFileNameWFn>("GetModuleFileNameW");
+  if (!get_module_file_name) {
+    return {};
+  }
+  std::wstring buffer(MAX_PATH, L'\0');
+  while (true) {
+    DWORD length =
+        get_module_file_name(nullptr, buffer.data(), DWORD(buffer.size()));
+    if (!length) {
+      return {};
+    }
+    if (length < buffer.size()) {
+      buffer.resize(length);
+      break;
+    }
+    buffer.resize(buffer.size() * 2);
+  }
+  return std::filesystem::path(buffer);
+}
+
+}  // namespace
+
+const std::filesystem::path& GetExecutablePath() {
+  static const std::filesystem::path path = QueryExecutablePath();
+  return path;
+}
+
+const std::filesystem::path& GetLocalFolder() {
+  static const std::filesystem::path path = QueryLocalFolder();
+  return path;
+}
+
+const std::filesystem::path& GetInstalledFolder() {
+  // The executable is at the root of the installed package.
+  static const std::filesystem::path path = GetExecutablePath().parent_path();
+  return path;
+}
+
+void* LoadSystemLibrary(const wchar_t* name) {
+  using LoadLibraryExWFn = HMODULE(WINAPI*)(LPCWSTR, HANDLE, DWORD);
+  static const auto load_library_ex = GetSystemProc<LoadLibraryExWFn>("LoadLibraryExW");
+  if (!load_library_ex) {
+    return nullptr;
+  }
+  constexpr DWORD kLoadLibrarySearchSystem32 = 0x00000800;
+  return load_library_ex(name, nullptr, kLoadLibrarySearchSystem32);
+}
+
+void* GetSystemProcAddress(const char* name) {
+  if (HMODULE kernelbase = GetKernelBaseModule()) {
+    if (FARPROC proc = GetProcAddress(kernelbase, name)) {
+      return reinterpret_cast<void*>(proc);
+    }
+  }
+  if (HMODULE ntdll = GetNtdllModule()) {
+    if (FARPROC proc = GetProcAddress(ntdll, name)) {
+      return reinterpret_cast<void*>(proc);
+    }
+  }
+  return nullptr;
+}
