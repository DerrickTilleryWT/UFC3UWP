+if(REXGLUE_UWP AND NOT TARGET rex::rexglue)
+    set(REXGLUE_CODEGEN_TOOL "" CACHE FILEPATH
+        "rexglue.exe from a desktop build of the SDK, for codegen in UWP builds")
