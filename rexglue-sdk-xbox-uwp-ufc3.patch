+++ b/include/rex/input/winrt/winrt_input_driver.h
@@ -0,0 +1,87 @@
+/**
+ * @file        input/winrt/winrt_input_driver.h
+ *
+ * @brief       Controller input through Windows.Gaming.Input, for UWP builds
+ *              (Xbox Developer Mode), where SDL is not available.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+#include <rex/input/input_driver.h>
+#include <rex/platform.h>
+
+#if REX_PLATFORM_WINRT
+
+namespace rex::input::winrt {
+
+class WinRTInputDriver final : public InputDriver {
+ public:
+  static constexpr uint32_t kUserCount = 4;
+
+  explicit WinRTInputDriver(rex::ui::Window* window, size_t window_z_order);
+  ~WinRTInputDriver() override;
+
+  X_STATUS Setup() override;
+
+  void EnumerateDevices(std::vector<DeviceInfo>& out) override;
+  X_RESULT GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) override;
+  X_RESULT GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                 X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                              X_INPUT_KEYSTROKE* out_keystroke) override;
+
+ private:
+  // Per-slot implementations (a slot per Windows.Gaming.Input gamepad, in
+  // connection order); the device IDs above carry the slot.
+  X_RESULT GetCapabilities(uint32_t user_index, uint32_t flags, X_INPUT_CAPABILITIES* out_caps);
+  X_RESULT GetState(uint32_t user_index, X_INPUT_STATE* out_state);
+  X_RESULT SetState(uint32_t user_index, X_INPUT_VIBRATION* vibration);
+  X_RESULT GetKeystroke(uint32_t user_index, uint32_t flags, X_INPUT_KEYSTROKE* out_keystroke);
+
+  struct Impl;
+
+  enum class RepeatState {
+    Idle,       // no buttons pressed or repeating has ended
+    Waiting,    // a button is held and the delay is awaited
+    Repeating,  // actively repeating at a rate
+  };
+  struct KeystrokeState {
+    uint64_t buttons = 0;
+    RepeatState repeat_state = RepeatState::Idle;
+    uint8_t repeat_butt_idx = 0;
+    uint32_t repeat_time = 0;
+  };
+  struct ControllerState {
+    bool connected = false;
+    bool wireless = false;
+    uint64_t last_timestamp = 0;
+    X_INPUT_STATE state = {};
+    bool state_changed = false;
+    bool is_active = false;
+  };
+
+  // Refreshes the connected controllers and their readings. Must be called
+  // with mutex_ held.
+  void UpdateLocked();
+  uint64_t AnalogToKeyfield(const X_INPUT_GAMEPAD& gamepad) const;
+
+  std::unique_ptr<Impl> impl_;
+  std::mutex mutex_;
+  std::array<ControllerState, kUserCount> controllers_ = {};
+  std::array<KeystrokeState, kUserCount> keystroke_states_ = {};
+  std::chrono::steady_clock::time_point last_list_refresh_ = {};
+};
+
+}  // namespace rex::input::winrt
+
+#endif  // REX_PLATFORM_WINRT
