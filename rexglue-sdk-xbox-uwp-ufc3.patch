diff --git a/thirdparty/ffmpeg-uwp/config.h b/thirdparty/ffmpeg-uwp/config.h
new file mode 100644
index 0000000..3f6dc83
--- /dev/null
+++ b/thirdparty/ffmpeg-uwp/config.h
@@ -0,0 +1,38 @@
+/*
+ * FFmpeg configuration for UWP builds of ReXGlue (Xbox Developer Mode).
+ *
+ * The regular Windows configuration, with the APIs that aren't available to
+ * UWP (app container) apps switched off. FFmpeg has its own UWP/WinRT code
+ * paths, selected by HAVE_UWP and HAVE_WINRT. This file shadows FFmpeg's own
+ * config.h through the include path order (see thirdparty/CMakeLists.txt).
+ */
+
+#include "config_windows_x86_64.h"
+
+#undef HAVE_UWP
+#define HAVE_UWP 1
+#undef HAVE_WINRT
+#define HAVE_WINRT 1
+
+#undef HAVE_COMMANDLINETOARGVW
+#define HAVE_COMMANDLINETOARGVW 0
+#undef HAVE_GETMODULEHANDLE
+#define HAVE_GETMODULEHANDLE 0
+#undef HAVE_GETPROCESSAFFINITYMASK
+#define HAVE_GETPROCESSAFFINITYMASK 0
