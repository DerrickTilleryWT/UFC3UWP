+/**
+ * @file        ui/winrt_core_window_util.h
+ *
+ * @brief       CoreWindow helpers shared by the UWP window, surface and app
+ *              context. Private to rexui.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+
