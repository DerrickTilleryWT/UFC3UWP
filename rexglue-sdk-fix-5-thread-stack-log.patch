 namespace rex {
 
+#if REX_PLATFORM_WINRT
+namespace {
+// Host address of each recompiled guest function, sorted, for naming the
+// game's code in stack logs ("sub_82ABCDEF+0x40").
+std::vector<std::pair<uint64_t, uint32_t>> guest_function_starts_;
+uint64_t guest_code_module_ = 0;
+
+std::string SymbolizeGuestCode(uint64_t address) {
+  if (guest_function_starts_.empty() || rex::platform::uwp::GetModuleBase(address) != guest_code_module_) {
+    return {};
+  }
+  auto it = std::upper_bound(guest_function_starts_.begin(), guest_function_starts_.end(),
+                             std::make_pair(address, UINT32_MAX));
+  if (it == guest_function_starts_.begin()) {
+    return {};
+  }
+  --it;
+  return fmt::format("sub_{:08X}+0x{:X}", it->second, address - it->first);
+}
+
+void BuildGuestFunctionTable(const PPCFuncMapping* mappings) {
+  if (!mappings || !guest_function_starts_.empty()) {
+    return;
+  }
+  for (size_t i = 0; mappings[i].guest != 0; ++i) {
+    if (mappings[i].host) {
+      guest_function_starts_.emplace_back(reinterpret_cast<uint64_t>(mappings[i].host),
+                                          uint32_t(mappings[i].guest));
+    }
+  }
+  std::sort(guest_function_starts_.begin(), guest_function_starts_.end());
+  if (!guest_function_starts_.empty()) {
+    guest_code_module_ = rex::platform::uwp::GetModuleBase(guest_function_starts_.front().first);
+    rex::platform::uwp::SetAddressSymbolizer(&SymbolizeGuestCode);
+  }
+}
+
+// Logs where every game and emulator thread is right now. Used to see what a
+// stuck game waits for (Back+Start on the pad).
+void LogAllThreadStacks(system::KernelState* kernel_state) {
+  if (!kernel_state) {
+    return;
+  }
+  auto threads = kernel_state->object_table()->GetObjectsByType<system::XThread>();
+  REXLOG_INFO("Thread stacks ({} threads):", threads.size());
+  for (auto& thread : threads) {
+    if (!thread || !thread->is_running() || !thread->thread()) {
+      continue;
+    }
+    rex::platform::uwp::LogThreadStack(
+        thread->thread()->native_handle(),
+        fmt::format("[stack] {}", thread->thread()->name()));
+  }
+  REXLOG_INFO("Thread stacks: end");
+}
+}  // namespace
+#endif
