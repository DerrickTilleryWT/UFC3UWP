index 0671361..d4948c2 100644
--- a/include/rex/platform/uwp.h
+++ b/include/rex/platform/uwp.h
@@ -15,7 +15,9 @@
 
 #if REX_PLATFORM_WINRT
 
+#include <cstdint>
 #include <filesystem>
+#include <string>
 
 namespace rex::platform::uwp {
 
@@ -60,6 +62,18 @@ void InstallCrashLogging();
 // logging is set up.
 void StartMemoryUsageLogging();
 
+// Names an address in the game's recompiled code (for example
+// "sub_82ABCDEF+0x40"), or returns an empty string. Used by the stack logs.
+using AddressSymbolizer = std::string (*)(uint64_t address);
+void SetAddressSymbolizer(AddressSymbolizer symbolizer);
+
+// Base address of the module (exe or DLL) containing `address`, or 0.
+uint64_t GetModuleBase(uint64_t address);
+
+// Logs another thread's call stack (with `label` on each line). The thread is
+// suspended only while its stack is read. Not for the calling thread.
+void LogThreadStack(void* thread_handle, const std::string& label);
+
 }  // namespace rex::platform::uwp
 
 #endif  // REX_PLATFORM_WINRT
