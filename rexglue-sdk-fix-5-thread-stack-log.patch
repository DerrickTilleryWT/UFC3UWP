 }
 
-// Logs the call stack of the crashed thread, unwinding from its context.
-void LogStack(const CONTEXT* crash_context) {
+// Collects return addresses by unwinding from a context, without allocating
+// (the thread may be suspended while holding a heap lock).
+size_t WalkStack(CONTEXT context, uint64_t* frames, size_t max_frames) {
   static const auto lookup =
       GetSystemProc<RtlLookupFunctionEntryFn>("RtlLookupFunctionEntry");
   static const auto unwind =
       GetSystemProc<RtlVirtualUnwindFn>("RtlVirtualUnwind");
-  if (!crash_context) {
-    return;
-  }
-  CONTEXT context = *crash_context;
-  CrashLogLine("CRASH: call stack (most recent first):");
-  for (int frame = 0; frame < 48; ++frame) {
+  size_t count = 0;
+  while (count < max_frames) {
     uint64_t pc = context.Rip;
     if (!pc) {
       break;
     }
-    CrashLogLine(fmt::format("CRASH:   #{:02} {}", frame, DescribeAddress(pc)));
+    frames[count++] = pc;
     if (!lookup || !unwind) {
       break;
     }
@@ -330,6 +335,20 @@ void LogStack(const CONTEXT* crash_context) {
       context.Rsp += sizeof(uint64_t);
     }
   }
+  return count;
+}
+
+// Logs the call stack of the crashed thread, unwinding from its context.
+void LogStack(const CONTEXT* crash_context) {
+  if (!crash_context) {
+    return;
+  }
+  uint64_t frames[48];
+  size_t count = WalkStack(*crash_context, frames, std::size(frames));
+  CrashLogLine("CRASH: call stack (most recent first):");
+  for (size_t frame = 0; frame < count; ++frame) {
+    CrashLogLine(fmt::format("CRASH:   #{:02} {}", frame, DescribeAddress(frames[frame])));
+  }
 }
 
 LONG WINAPI CrashFilter(EXCEPTION_POINTERS* info) {
@@ -441,6 +460,53 @@ void StartMemoryUsageLogging() {
   }).detach();
 }
 
+uint64_t GetModuleBase(uint64_t address) {
+  return reinterpret_cast<uint64_t>(ModuleFromAddress(reinterpret_cast<const void*>(address)));
+}
+
+void SetAddressSymbolizer(AddressSymbolizer symbolizer) {
+  address_symbolizer_.store(symbolizer);
+}
+
+void LogThreadStack(void* thread_handle, const std::string& label) {
+  using SuspendResumeThreadFn = DWORD(WINAPI*)(HANDLE);
+  using GetThreadContextFn = BOOL(WINAPI*)(HANDLE, LPCONTEXT);
+  static const auto suspend_thread = GetSystemProc<SuspendResumeThreadFn>("SuspendThread");
+  static const auto resume_thread = GetSystemProc<SuspendResumeThreadFn>("ResumeThread");
+  static const auto get_thread_context = GetSystemProc<GetThreadContextFn>("GetThreadContext");
+  auto log_line = [](const std::string& line) {
+    if (auto logger = rex::GetLogger()) {
+      logger->info("{}", line);
+    }
+  };
+  if (!suspend_thread || !resume_thread || !get_thread_context || !thread_handle) {
+    log_line(fmt::format("{}: can't read the stack (thread functions missing)", label));
+    return;
+  }
+  HANDLE handle = static_cast<HANDLE>(thread_handle);
+  if (suspend_thread(handle) == DWORD(-1)) {
+    log_line(fmt::format("{}: can't suspend the thread (error {})", label, GetLastError()));
+    return;
+  }
+  uint64_t frames[40];
+  size_t count = 0;
+  alignas(16) CONTEXT context = {};
+  context.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+  bool have_context = get_thread_context(handle, &context) != FALSE;
+  DWORD context_error = have_context ? 0 : GetLastError();
+  if (have_context) {
+    count = WalkStack(context, frames, std::size(frames));
+  }
+  resume_thread(handle);
+  if (!have_context) {
+    log_line(fmt::format("{}: can't read the thread context (error {})", label, context_error));
+    return;
+  }
+  for (size_t frame = 0; frame < count; ++frame) {
+    log_line(fmt::format("{}   #{:02} {}", label, frame, DescribeAddress(frames[frame])));
+  }
+}
+
 }  // namespace rex::platform::uwp
 
 #endif  // REX_PLATFORM_WINRT
